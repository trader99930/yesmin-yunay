{
  "name": "yesmin-ai-assistant",
  "productName": "Yesmin AI Assistant",
  "version": "2.5.0",
  "description": "Celestial 3D Hologram AI Companion & Voice Assistant for Windows Laptop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:win-portable": "electron-builder --win portable",
    "dist": "electron-builder"
  },
  "keywords": [
    "ai",
    "assistant",
    "voice",
    "gemini",
    "multimodal",
    "companion",
    "windows"
  ],
  "author": "Sushil / Yunay AI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {},
  "build": {
    "appId": "com.yunay.yesmin.desktop",
    "productName": "Yesmin AI Assistant",
    "copyright": "Copyright © 2026 Yesmin AI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yesmin AI Assistant"
    },
    "portable": {
      "artifactName": "Yesmin-AI-Assistant-Portable-${version}.exe"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
